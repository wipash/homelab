---
version: v1alpha1
machine:
  ca:
    crt: op://Homelab/talos/MACHINE_CA_CRT
    key: op://Homelab/talos/MACHINE_CA_KEY
  certSANs:
    - homelab.k8s.mcgrath.nz
    - 10.0.16.132
    - 127.0.0.1
  features:
    diskQuotaSupport: true
  # KubeletConfig cannot coexist with this legacy block; retain it for the
  # OpenEBS bind mount until extraMounts has a supported focused replacement.
  kubelet:
    defaultRuntimeSeccompProfileEnabled: true
    disableManifestsDirectory: true
    extraArgs:
      rotate-server-certificates: "true"
    extraConfig:
      maxPods: 150  # Confirm
      serializeImagePulls: false
      shutdownGracePeriod: 120s
      shutdownGracePeriodCriticalPods: 30s
    extraMounts:
      - destination: /var/openebs/local
        type: bind
        source: /var/openebs/local
        options:
          - bind
          - rshared
          - rw
    image: ghcr.io/siderolabs/kubelet:v1.37.0
  token: op://Homelab/talos/MACHINE_TOKEN
  type: controlplane
cluster:
  token: op://Homelab/talos/CLUSTER_TOKEN
  etcd:
    advertisedSubnets:
      - 10.0.16.0/24
    ca:
      crt: op://Homelab/talos/CLUSTER_ETCD_CA_CRT
      key: op://Homelab/talos/CLUSTER_ETCD_CA_KEY
    extraArgs:
      listen-metrics-urls: http://0.0.0.0:2381
---
apiVersion: v1alpha1
kind: DiscoveryServiceConfig
name: default
endpoint: https://discovery.talos.dev/
---
apiVersion: v1alpha1
kind: DiscoveryIdentityConfig
clusterID: op://Homelab/talos/CLUSTER_ID
clusterSecret: op://Homelab/talos/CLUSTER_SECRET
---
apiVersion: v1alpha1
kind: UnattendedInstallConfig
installer:
  image: factory.talos.dev/metal-installer/c50886058ea797e239090fedf78b6c39a70b3c07905cd563b5b12f848f9b087c:v1.14.0
provisioning:
  diskSelector:
    match: disk.dev_path == "/dev/sda"
  wipe: false
---
apiVersion: v1alpha1
kind: ResolverConfig
nameservers:
  - address: 10.0.16.4
searchDomains:
  disableDefault: true
hostDNS:
  enabled: true
  forwardKubeDNSToHost: false
  resolveMemberNames: true
---
apiVersion: v1alpha1
kind: StaticHostConfig
name: 10.0.16.132
hostnames:
  - homelab.k8s.mcgrath.nz
---
apiVersion: v1alpha1
kind: TimeSyncConfig
enabled: true
ntp:
  servers:
    - 0.nz.pool.ntp.org
    - 1.nz.pool.ntp.org
    - 2.nz.pool.ntp.org
    - 3.nz.pool.ntp.org
---
apiVersion: v1alpha1
kind: SecurityProfileConfig
workloadIsolation: false
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: nbd
---
apiVersion: v1alpha1
kind: SysctlConfig
params:
  fs.inotify.max_queued_events: "65536"
  fs.inotify.max_user_instances: "8192"
  fs.inotify.max_user_watches: "1048576"
  net.core.default_qdisc: fq
  net.core.rmem_max: "67108864"
  net.core.wmem_max: "67108864"
  net.ipv4.neigh.default.gc_thresh1: "4096"
  net.ipv4.neigh.default.gc_thresh2: "8192"
  net.ipv4.neigh.default.gc_thresh3: "16384"
  net.ipv4.ping_group_range: 0 2147483647
  net.ipv4.tcp_congestion_control: bbr
  net.ipv4.tcp_fastopen: "3"
  net.ipv4.tcp_mtu_probing: "1"
  net.ipv4.tcp_notsent_lowat: "131072"
  net.ipv4.tcp_rmem: 4096 87380 33554432
  net.ipv4.tcp_slow_start_after_idle: "0"
  net.ipv4.tcp_window_scaling: "1"
  net.ipv4.tcp_wmem: 4096 65536 33554432
  sunrpc.tcp_max_slot_table_entries: "128"
  sunrpc.tcp_slot_table_entries: "128"
  user.max_user_namespaces: "11255"
  vm.nr_hugepages: "1024"
---
apiVersion: v1alpha1
kind: EtcFileConfig
name: nfsmount.conf
mode: 0o644
contents: |
  [ NFSMount_Global_Options ]
  nfsvers=4.1
  hard=True
  nconnect=8
  noatime=True
  rsize=1048576
  wsize=1048576
---
apiVersion: v1alpha1
kind: CRICustomizationConfig
name: 20-customization
content: |
  [plugins."io.containerd.cri.v1.images"]
    discard_unpacked_layers = false
  [plugins."io.containerd.cri.v1.runtime"]
    cdi_spec_dirs = ["/var/cdi/static", "/var/cdi/dynamic"]
    device_ownership_from_security_context = true
---
apiVersion: v1alpha1
kind: KubeClusterConfig
clusterName: homelab
endpoint: https://10.0.16.132:6443
---
apiVersion: v1alpha1
kind: KubeNodeConfig
nodeIP:
  validSubnets:
    - 10.0.16.0/24
labels:
  node-role.kubernetes.io/control-plane: ""
  node.kubernetes.io/gpu: "true"
  topology.kubernetes.io/region: homelab
taints: {}
---
apiVersion: v1alpha1
kind: KubeNetworkConfig
dnsDomain: cluster.local
podSubnets:
  - 10.244.0.0/16
serviceSubnets:
  - 10.96.0.0/12
---
apiVersion: v1alpha1
kind: KubeAPIServerCAConfig
issuingCA:
  cert: op://Homelab/talos/CLUSTER_CA_CRT
  key: op://Homelab/talos/CLUSTER_CA_KEY
---
apiVersion: v1alpha1
kind: KubeAggregatorCAConfig
issuingCA:
  cert: op://Homelab/talos/CLUSTER_AGGREGATORCA_CRT
  key: op://Homelab/talos/CLUSTER_AGGREGATORCA_KEY
---
apiVersion: v1alpha1
kind: KubePrismConfig
port: 7445
---
apiVersion: v1alpha1
kind: KubeTalosAPIAccessConfig
allowedRoles:
  - os:admin
allowedKubernetesNamespaces:
  - system-upgrade
  - actions-runner-system
---
apiVersion: v1alpha1
kind: KubeAuditPolicyConfig
configuration:
  apiVersion: audit.k8s.io/v1
  kind: Policy
  rules:
    - level: Metadata
---
apiVersion: v1alpha1
kind: KubeAuthenticationConfig
configuration:
  anonymous:
    # Talos probes these endpoints without credentials; all other paths require authentication.
    enabled: true
    conditions:
      - path: /livez
      - path: /readyz
      - path: /healthz
  jwt: []
---
apiVersion: v1alpha1
kind: KubeAuthorizerConfig
name: node
type: Node
---
apiVersion: v1alpha1
kind: KubeAuthorizerConfig
name: rbac
type: RBAC
---
apiVersion: v1alpha1
kind: KubeEtcdEncryptionConfig
config:
  resources:
    - providers:
        - aescbc:
            keys:
              - name: key1
                secret: op://Homelab/talos/CLUSTER_AESCBCENCRYPTIONSECRET
        - identity: {}
      resources:
        - secrets
---
apiVersion: v1alpha1
kind: KubeServiceAccountConfig
issuer:
  privateKey: op://Homelab/talos/CLUSTER_SERVICEACCOUNT_KEY
  issuerURL: https://10.0.16.132:6443
---
apiVersion: v1alpha1
kind: KubeAPIServerConfig
image: registry.k8s.io/kube-apiserver:v1.37.0
certExtraSANs:
  - homelab.k8s.mcgrath.nz
  - 10.0.16.132
  - 127.0.0.1
extraArgs:
  enable-aggregator-routing: "true"
  feature-gates: MutatingAdmissionPolicy=true
  runtime-config: admissionregistration.k8s.io/v1beta1=true
---
apiVersion: v1alpha1
kind: KubeControllerManagerConfig
image: registry.k8s.io/kube-controller-manager:v1.37.0
extraArgs:
  bind-address: 0.0.0.0
---
apiVersion: v1alpha1
kind: KubeSchedulerConfig
image: registry.k8s.io/kube-scheduler:v1.37.0
config:
  apiVersion: kubescheduler.config.k8s.io/v1
  kind: KubeSchedulerConfiguration
  profiles:
    - schedulerName: default-scheduler
      plugins:
        score:
          disabled:
            - name: ImageLocality
      pluginConfig:
        - name: PodTopologySpread
          args:
            defaultingType: List
            defaultConstraints:
              - maxSkew: 1
                topologyKey: kubernetes.io/hostname
                whenUnsatisfiable: ScheduleAnyway
extraArgs:
  bind-address: 0.0.0.0
---
apiVersion: v1alpha1
kind: KubeProxyConfig
enabled: false
image: registry.k8s.io/kube-proxy:v1.37.0
---
apiVersion: v1alpha1
kind: KubeCoreDNSConfig
enabled: false
