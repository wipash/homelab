---
apiVersion: v1alpha1
kind: HostnameConfig
hostname: hp2.k8s.mcgrath.nz
---
apiVersion: v1alpha1
kind: LinkAliasConfig
name: net0
selector:
  match: mac(link.permanent_addr) == "e4:1d:a6:9e:ce:04"
---
apiVersion: v1alpha1
kind: LinkAliasConfig
name: net1
selector:
  match: mac(link.permanent_addr) == "50:65:f3:33:6e:f1"
---
apiVersion: v1alpha1
kind: LinkConfig
name: net0
up: true
mtu: 1500
addresses:
  - address: 10.0.16.135/24
  - address: 172.20.0.3/24
routes:
  # Omitting destination selects the IPv4 default route.
  - gateway: 10.0.16.1
---
apiVersion: v1alpha1
kind: LinkConfig
name: net1
up: true
---
apiVersion: v1alpha1
kind: Layer2VIPConfig
name: 10.0.16.132
link: net0
